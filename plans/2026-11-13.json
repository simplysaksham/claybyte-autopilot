    "slides": [
     {
      "type": "myth",
      "n": "01",
      "label": "MYTH VS FACT",
      "title": "Waiting is *part of the job*",
      "myth": "Slow feedback is just how clients are.",
      "fact": "Slow feedback is a *missing clause*. Put a review window in the SOW.",
      "why": "Then the delay is their choice, not your problem."
     },
     {
      "type": "myth",
      "n": "02",
      "label": "MYTH VS FACT",
      "title": "Silence means *yes*",
      "myth": "No reply by the deadline = approved.",
      "fact": "Only if your SOW *says so*. Otherwise they choose: approve, new date, or cut scope.",
      "why": "Some agencies use deemed approval. Others never do. Pick one, in writing."
     },
     {
      "type": "myth",
      "n": "03",
      "label": "MYTH VS FACT",
      "title": "More reviewers, *better work*",
      "myth": "Anyone on their team can send notes.",
      "fact": "One *named approver* + a backup. One list of notes per round.",
      "why": "Five people, five inboxes, five versions of done."
     },
     {
      "type": "doc",
